      }
    },
    {
      "name": "string-escapes",
      "input": "{\"s\":\"line\\nbreak\\t\\\"quoted\\\"\"}",
      "output": {
        "formatted": "{\n  \"s\": \"line\\nbreak\\t\\\"quoted\\\"\"\n}"
      }
    },
    {
      "name": "array-root",
      "input": "[1,\"two\",{\"three\":3}]",
