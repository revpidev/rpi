{
  "markdownToText": [
    {
      "name": "headings",
      "input": "# Title\n## Sub\nnormal",
      "output": "Title\nSub\nnormal"
    },
    {
      "name": "emphasis",
      "input": "**bold** and *ital* alone",
      "output": "bold and ital alone"
    },
    {
      "name": "links-and-images",
      "input": "[text](https://x) and ![alt](img.png)",
      "output": "text and !alt"
    },
    {
      "name": "image-only-link-precedence",
      "input": "a [l](u) ![img](y) b",
      "output": "a l !img b"
    },
    {
      "name": "quotes",
      "input": "> quoted line\nnormal",
      "output": "quoted line\nnormal"
    },
    {
      "name": "lists",
      "input": "- dash\n* star\n+ plus\n1. ordered",
      "output": "• dash\n• star\n• plus\n1. ordered"
    },
    {
      "name": "inline-code",
      "input": "use `cargo test` now",
      "output": "use cargo test now"
    },
    {
      "name": "multiline",
      "input": "# H\n\npara one\n\n- a\n- b\n\n> q\n\n**x**",
      "output": "H\n\npara one\n\n• a\n• b\n\nq\n\nx"
    },
    {
      "name": "no-markup",
      "input": "plain text  with  spaces",
      "output": "plain text  with  spaces"
    },
    {
      "name": "empty",
      "input": "",
      "output": ""
    }
  ],
  "truncateContent": [
    {
      "name": "under",
      "input": {
        "content": "abc",
        "maxChars": 10
      },
      "output": "abc"
    },
    {
      "name": "exact",
      "input": {
        "content": "abcde",
        "maxChars": 5
      },
      "output": "abcde"
    },
    {
      "name": "over",
      "input": {
        "content": "abcdef",
        "maxChars": 3
      },
      "output": "abc\n\n[... truncated]"
    },
    {
      "name": "ascii-mid-word",
      "input": {
        "content": "0123456789",
        "maxChars": 4
      },
      "output": "0123\n\n[... truncated]"
    },
    {
      "name": "astral-bmp-mix",
      "input": {
        "content": "a😀b😀c😀d😀",
        "maxChars": 4
      },
      "output": "a😀b\n\n[... truncated]"
    },
    {
      "name": "astral-count-variant",
      "input": {
        "content": "😀😀😀😀",
        "maxChars": 3
      },
      "output": "😀�\n\n[... truncated]"
    },
    {
      "name": "newline-boundary",
      "input": {
        "content": "line1\nline2\nline3",
        "maxChars": 7
      },
      "output": "line1\nl\n\n[... truncated]"
    }
  ],
